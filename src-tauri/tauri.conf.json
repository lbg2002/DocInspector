{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "DocInspector",
  "version": "0.1.0",
  "identifier": "com.docinspector.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "DocInspector",
        "width": 1280,
        "height": 800,
        "minWidth": 900,
        "minHeight": 620,
        "backgroundColor": "#10141b"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "deb",
      "appimage"
    ],
    "icon": []
  }
}